# Multi-stage build for the fork image pushed to GHCR.
# Unlike Dockerfile.fork (needs a pre-built binary), this builds from source
# so GitHub Actions produces a durable image without local tooling.
FROM golang:1.25-alpine AS builder
RUN apk add --no-cache gcc g++ musl-dev fuse-dev
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG CHANNEL=fork
RUN CGO_ENABLED=1 go build -trimpath \
    -ldflags="-w -s \
      -X github.com/sirrobot01/decypharr/pkg/version.Version=${VERSION} \
      -X github.com/sirrobot01/decypharr/pkg/version.Channel=${CHANNEL}" \
    -o decypharr_fork .

FROM cy01/blackhole:latest
COPY --from=builder /app/decypharr_fork /usr/bin/decypharr
